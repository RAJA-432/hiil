# Copy this file to .env and fill in your actual API keys
#
# Settings are resolved with this priority:
#   1. Environment variables (highest)
#   2. config.yaml (settings section)
#   3. Built-in defaults

# --- Model provider -------------------------------------------------------
# "openrouter", "opencode", or "ollama" (local, no key needed).
MODEL_PROVIDER=openrouter

# Provider-specific model identifier.
#   OpenRouter example: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, ...
#   OpenCode example:  the model name exposed by your OpenCode endpoint
#   Ollama example:    gemma3, gemma3:4b, llama3.1, qwen2.5:7b (must be pulled)
MODEL_NAME=openai/gpt-4o-mini

# --- API key (REQUIRED - do not commit this!) -----------------------------
# Unified env var used by all providers.
#   - OpenRouter: https://openrouter.ai/keys
#   - OpenCode: key accepted by your OpenCode endpoint
#   - Ollama: not needed (leave empty or omit for local inference)
MODEL_API_KEY=

# --- Optional custom base URL ---------------------------------------------
# Overrides the automatically inferred base URL for the provider.
# BASE_URL=https://my-custom-endpoint/v1

# --- Appearance -----------------------------------------------------------
# Default theme: "opencode" or "cursor"
# CLI_THEME=cursor

# --- MCP server launch ---------------------------------------------------
# Set to 1 to launch MCP servers via `uv run` instead of `python`.
USE_UV=1
