{
  "description": "E2E API tests — each case is a request/assertion pair.",
  "fixture": "app",
  "cases": [
    {
      "id": "health_endpoint",
      "method": "GET",
      "path": "/health",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "const": "ok"}
        },
        "required": ["status"],
        "additional_properties": false
      },
      "expect_headers": {"content-type": "application/json"}
    },
    {
      "id": "non_streaming_chat",
      "method": "POST",
      "path": "/api/chat",
      "json": {"message": "hello", "session_id": "default"},
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "reply": {"type": "string", "min_length": 1}
        },
        "required": ["reply"],
        "additional_properties": false
      }
    },
    {
      "id": "status",
      "method": "GET",
      "path": "/api/status",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "session": {"type": "string"},
          "provider": {"type": "string", "min_length": 1},
          "model": {"type": "string", "min_length": 1},
          "messages": {"type": "integer"},
          "servers": {"type": "array"},
          "tools": {"type": "integer"}
        },
        "required": ["session", "provider", "model", "messages", "servers", "tools"]
      }
    },
    {
      "id": "list_sessions",
      "method": "GET",
      "path": "/api/sessions",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "sessions": {"type": "array", "min_items": 1},
          "active": {"type": "string"}
        },
        "required": ["sessions", "active"]
      },
      "expect_json_array_contains": {"sessions": "default"}
    },
    {
      "id": "list_models",
      "method": "GET",
      "path": "/api/models",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "models": {"type": "array", "min_items": 2},
          "active": {"type": "string", "min_length": 1}
        },
        "required": ["models", "active"]
      },
      "expect_json_types": {"active": "str"}
    },
    {
      "id": "switch_session",
      "method": "POST",
      "path": "/api/session/switch",
      "json": {"session_id": "default"},
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string", "const": "default"},
          "messages": {"type": "integer"}
        },
        "required": ["session_id", "messages"]
      }
    },
    {
      "id": "new_session",
      "method": "POST",
      "path": "/api/session/new",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "session_id": {"type": "string", "min_length": 1}
        },
        "required": ["session_id"]
      }
    },
    {
      "id": "list_tools",
      "method": "GET",
      "path": "/api/tools",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "tools": {"type": "array", "min_items": 1}
        },
        "required": ["tools"]
      },
      "expect_json_array_contains": {"tools": "read_file"}
    },
    {
      "id": "get_history",
      "method": "GET",
      "path": "/api/history/default",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "messages": {"type": "array"}
        },
        "required": ["messages"]
      },
      "expect_json_types": {"messages.0.role": "str", "messages.0.content": "str"}
    },
    {
      "id": "set_model",
      "method": "POST",
      "path": "/api/model",
      "json": {"model": "llama3"},
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "model": {"type": "string", "const": "llama3"}
        },
        "required": ["model"]
      }
    },
    {
      "id": "set_model_missing",
      "method": "POST",
      "path": "/api/model",
      "json": {},
      "expect_status": 400
    },
    {
      "id": "empty_message_rejected",
      "method": "POST",
      "path": "/api/chat",
      "json": {"message": "", "session_id": "default"},
      "expect_status": 400,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "detail": {"type": "string", "const": "Message cannot be empty"}
        },
        "required": ["detail"]
      }
    },
    {
      "id": "tool_call_success",
      "method": "POST",
      "path": "/api/tools/call",
      "json": {"name": "read_file", "arguments": {"path": "test.txt"}},
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "result": {"type": "string", "min_length": 1}
        },
        "required": ["result"]
      }
    },
    {
      "id": "tool_call_not_found",
      "method": "POST",
      "path": "/api/tools/call",
      "json": {"name": "nonexistent_tool", "arguments": {}},
      "expect_status": 404,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "detail": {"type": "string", "min_length": 1}
        },
        "required": ["detail"]
      }
    },
    {
      "id": "tool_call_missing_name",
      "method": "POST",
      "path": "/api/tools/call",
      "json": {"arguments": {}},
      "expect_status": 422,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "detail": {"type": "array", "min_items": 1}
        },
        "required": ["detail"]
      },
      "expect_json_types": {"detail.0.msg": "str"}
    },
    {
      "id": "history_nonexistent_session",
      "method": "GET",
      "path": "/api/history/nonexistent_sid",
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "messages": {"type": "array"}
        },
        "required": ["messages"]
      },
      "expect_json_types": {"messages.0.role": "str", "messages.0.content": "str"}
    },
    {
      "id": "switch_session_missing_id",
      "method": "POST",
      "path": "/api/session/switch",
      "json": {},
      "expect_status": 400,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "detail": {"type": "string", "const": "session_id required"}
        },
        "required": ["detail"]
      }
    },
    {
      "id": "chat_missing_message_field",
      "method": "POST",
      "path": "/api/chat",
      "json": {"session_id": "default"},
      "expect_status": 422,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "detail": {"type": "array", "min_items": 1}
        },
        "required": ["detail"]
      }
    },
    {
      "id": "chat_without_session_id",
      "method": "POST",
      "path": "/api/chat",
      "json": {"message": "hello"},
      "expect_status": 200,
      "expect_json_schema": {
        "type": "object",
        "properties": {
          "reply": {"type": "string", "min_length": 1}
        },
        "required": ["reply"]
      }
    }
  ]
}
