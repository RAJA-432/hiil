{
  "description": "MCP Server Integration Tests",
  "command": "python",
  "args": ["-m", "mcp_server"],
  "cases": [
    {
      "id": "list_tools",
      "action": "list_tools",
      "expect": {
        "tool_names": ["read_document", "edit_document", "search_resources", "read_text_resource", "format_document"],
        "min_count": 5
      }
    },
    {
      "id": "read_document",
      "action": "call_tool",
      "tool": "read_document",
      "args": {"doc_id": "spec.txt"},
      "expect": {"text_contains": "technical requirements"}
    },
    {
      "id": "edit_document",
      "action": "call_tool",
      "tool": "edit_document",
      "args": {"doc_id": "spec.txt", "old_str": "technical requirements", "new_str": "tech specs"},
      "expect": {"text_contains": "tech specs"}
    },
    {
      "id": "search_resources",
      "action": "call_tool",
      "tool": "search_resources",
      "args": {"query": "test"},
      "expect": {"text_contains": "test"}
    },
    {
      "id": "format_document",
      "action": "call_tool",
      "tool": "format_document",
      "args": {"text": "  hello   world  "},
      "expect": {"text_contains": "  hello   world"}
    },
    {
      "id": "list_resources",
      "action": "list_resources",
      "expect": {"uri_contains": "docs://documents"}
    },
    {
      "id": "read_resource",
      "action": "read_resource",
      "uri": "docs://documents",
      "expect": {"contains": "spec.txt"}
    },
    {
      "id": "read_document_not_found",
      "action": "call_tool",
      "tool": "read_document",
      "args": {"doc_id": "nonexistent.txt"},
      "expect": {"text_contains_any": ["not found", "error"]}
    },
    {
      "id": "search_resources_empty",
      "action": "call_tool",
      "tool": "search_resources",
      "args": {"query": "zzz_nonexistent_zzz"},
      "expect": {"text_contains_any": ["no", "not found"], "allow_empty": true}
    }
  ]
}
